{
  "name": "ForgePortal",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/postgresql:1": {
      "version": "16"
    }
  },

  "forwardPorts": [3000, 4000, 5432],
  "portsAttributes": {
    "3000": { "label": "UI",         "onAutoForward": "notify" },
    "4000": { "label": "API",        "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "postCreateCommand": "pnpm install && bash .devcontainer/setup.sh",

  "remoteEnv": {
    "DB_HOST":     "localhost",
    "DB_PORT":     "5432",
    "DB_USER":     "postgres",
    "DB_PASSWORD": "postgres",
    "DB_NAME":     "forgeportal_dev",
    "NODE_ENV":    "development"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "redhat.vscode-yaml",
        "ckolkman.vscode-postgres",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
