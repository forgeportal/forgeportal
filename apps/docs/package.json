    "@mdx-js/react":              "^3.1.0",
    "@mermaid-js/layout-elk":     "^0.1.9",
    "clsx":                       "^2.1.1",
    "prism-react-renderer":       "^2.4.1",
    "react":                      "^19.0.0",
    "react-dom":                  "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/types":               "^3.10.0",
