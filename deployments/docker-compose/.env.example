# === Database ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=forgeportal
DB_USER=forge
DB_PASSWORD=forge_local_dev

# === Migrations / Seed ===
MIGRATIONS_DIR=/app/tools/migration
SEED_FILE=/app/tools/seed/seed_v1.sql
# RUN_SEED=true

# === API Server ===
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# === OIDC ===
# Leave all OIDC_* commented out for local dev (dev-bypass mode — no login required).
# Set these to connect a real identity provider (Keycloak, Okta, Auth0, Azure AD, Cognito).
# See: https://docs.forgeportal.dev/docs/configuration/oidc-setup
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- With bundled Keycloak (docker-compose.keycloak.yml) ---
# Run: docker compose -f docker-compose.yml -f docker-compose.keycloak.yml up
# Then uncomment below (client secret is pre-set in the realm export):
# OIDC_ISSUER=http://keycloak:8080/realms/forgeportal
# OIDC_CLIENT_ID=forgeportal
# OIDC_CLIENT_SECRET=forgeportal-dev-secret
# Test user: alex@acmecorp.com / demo1234  (role: platform-admin)
#
# --- With an external IdP (Okta, Auth0, Azure AD, Cognito) ---
# OIDC_ISSUER=https://<your-idp-issuer>
# OIDC_CLIENT_ID=<your-client-id>
# OIDC_CLIENT_SECRET=<your-client-secret>

# === SCM ===
# GitHub — Personal Access Token (classic, scopes: repo, read:org)
# SCM_GITHUB_TOKEN=ghp_YourPersonalAccessTokenHere
#
# GitHub — App (alternative to PAT, preferred for organisations)
# SCM_GITHUB_APP_ID=
# SCM_GITHUB_APP_PRIVATE_KEY_PATH=/app/secrets/github-app.pem
# SCM_GITHUB_WEBHOOK_SECRET=
#
# GitLab — Personal Access Token (scopes: api, read_repository)
# SCM_GITLAB_TOKEN=
# SCM_GITLAB_BASE_URL=https://gitlab.com
# SCM_GITLAB_WEBHOOK_SECRET=

# === Encryption ===
ENCRYPTION_KEY=local-dev-key-change-in-prod-32chars!
