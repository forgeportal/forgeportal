FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@10.6.2 --activate
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/ui/ apps/ui/
# Copy all packages/ so workspace plugin symlinks resolve correctly.
# The root .dockerignore excludes dist/, so each package is compiled below.
COPY packages/ packages/
COPY tsconfig.base.json tsconfig.ui.json ./
RUN pnpm install --filter @forgeportal/ui...
# Build all packages that the UI depends on (plugin-sdk and any installed plugins).
# turbo respects the dependency graph so packages build in the right order.
RUN pnpm --filter @forgeportal/plugin-sdk build
RUN pnpm --filter "@forgeportal/plugin-*" build
WORKDIR /app/apps/ui
ENV VITE_API_URL=http://api:4000
EXPOSE 3000
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "3000"]
