{
  "name": "forgeportal",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:db": "docker compose -f deployments/docker-compose/docker-compose.yml up postgres -d --wait",
    "dev:full": "pnpm dev:db && pnpm dev",
    "dev:stop": "docker compose -f deployments/docker-compose/docker-compose.yml stop postgres",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "forge:sync": "tsx packages/cli/src/bin.ts sync",
    "forge:sync:dry": "tsx packages/cli/src/bin.ts sync --dry-run",
    "forge:sync:check": "tsx packages/cli/src/bin.ts sync --check",
    "seed:demo": "tsx tools/seed/seed_demo.ts",
    "seed:reset": "tsx tools/seed/seed_demo.ts --reset",
    "seed:docs": "tsx tools/seed/seed_docs.ts",
    "seed:all": "pnpm seed:demo && pnpm seed:docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.5",
    "jiti": "^2.6.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "tsx": "*",
    "turbo": "^2.8.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/*",
      "sodium-native"
    ]
  }
}
