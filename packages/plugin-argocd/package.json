{
  "name": "@forgeportal/plugin-argocd",
  "version": "1.3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./package.json":            "./package.json",
    "./forgeportal-plugin.json": "./forgeportal-plugin.json"
  },
  "main":  "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build":          "tsc",
    "prepublishOnly": "pnpm build",
    "test":           "vitest run",
    "lint":           "eslint src/",
    "clean":          "rm -rf dist"
  },
  "dependencies": {
    "@forgeportal/plugin-sdk": "workspace:*",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "*",
    "@types/react":          "*",
    "fastify":               "^5.10.0",
    "react":                 "*",
    "vitest":                "^3.2.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react":                 ">=19"
  },
  "peerDependenciesMeta": {
    "react":                 { "optional": true },
    "@tanstack/react-query": { "optional": true }
  }
}
