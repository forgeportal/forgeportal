{
  "name": "@forgeportal/cli",
  "version": "1.2.0",
  "type": "module",
  "bin": {
    "forge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build":          "tsc",
    "prepublishOnly": "pnpm build",
    "test":           "vitest run",
    "lint":           "eslint src/",
    "clean":          "rm -rf dist"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml":  "^4.0.9",
    "@types/node":     "*",
    "vitest":          "*"
  }
}
